# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional live data. Without these keys the app uses its snapshot data only.
# Live flights, hotels and Airbnb stays. Free plan: 250 searches a month, https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Live restaurants and local transport. Enable "Places API (New)" and "Routes API" for this key,
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Only for a deployed copy: ask for this password before the app opens.
APP_PASSWORD=

# Optional emails for password accounts (confirm links and password resets), through Brevo's free plan.
# Without them, the owner (OWNER_EMAIL, signed in with Google) confirms new accounts in Settings.
# Key: https://app.brevo.com/settings/keys/api  Sender: an address verified under Senders in Brevo.
BREVO_API_KEY=
MAIL_FROM=
# The app's public address, for the links in those emails (empty: the address the page was opened at).
APP_URL=
